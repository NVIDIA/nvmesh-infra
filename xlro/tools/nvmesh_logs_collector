def collect_docker_containers_logs():
    print_to_stdout("collecting logs from docker containers...")
    cmd = "which docker"
    res = runCommand(cmd)

    if int(res[2]) == True:
        print_to_stdout("Error: docker executable is missing, cannot collect logs from docker containers")
        return

    create_initial_collection_dir_and_info()

    for container_id in args.DOCKER_CONTAINERS:
        # dump logs from the docker container
        get_logs_cmd = "docker logs --timestamps --since=2h {0} > docker_{0}.logs".format(container_id)
        res = runCommand(get_logs_cmd)
        if int(res[2]) == True:
            print_to_stdout("Error: could not collect docker logs from container: {0}".format(container_id))

        if not args.DUMP_DB:
            continue

        success = dump_db_to_file("docker exec {0}".format(container_id), REMOTE_DB_DUMP_PATH)
        if success:
            # bring the dump
            cp_db_dump_cmd = "docker cp {0}:{1} ./{0}_{2}".format(container_id, REMOTE_DB_DUMP_PATH, DB_DUMP_DIRNAME)
            res = runCommand(cp_db_dump_cmd)
