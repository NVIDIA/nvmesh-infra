def get_management_pid():
    if os.path.isfile(MGMT_PID_FILE):
        with open(MGMT_PID_FILE, 'r') as f:
            try:
                return int(f.read().strip())
            except ValueError:
                print_to_stdout(f"Error: could not read management PID from {MGMT_PID_FILE}")
                return None
    else:
        print_to_stdout(f"Error: management PID file {MGMT_PID_FILE} not found")

    return None

def collect_mgmt_stats():
    # find the management app.js PID and do SIGUSR2
    # this will cause the management to dump the internalState to /var/log/nvmesh/mgmtStats/
    # these files will be collected
    mgmt_pid = get_management_pid()

    if not mgmt_pid:
        # error already printed in get_management_pid
        return

    # trigger mgmt internal state dump
    # Send SIGUSR2 to the management app.js PID
    cmd = f'kill -USR2 {mgmt_pid}'
    _, output, retcode = runCommand(cmd)
    if retcode != 0:
        print_to_stdout(f'Error: could not send SIGUSR2 to management app.js - exit code: {retcode} output: {output}')
        return

    # list the files in the mgmtStats directory
    cmd = "ls -l /var/log/nvmesh/mgmtStats"
    _, output, retcode = runCommand(cmd)
    if retcode != 0:
        print_to_stdout(f'Error: could not collect management stats - exit code: {retcode} output: {output}')


