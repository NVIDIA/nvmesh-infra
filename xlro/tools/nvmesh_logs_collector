    # Trigger the management internal-state dump (SIGUSR2) as early as possible
    # so that /var/log/nvmesh/mgmtStats is fully written by the time we copy it
    # later in the management collection phase.
    if is_mgmt:
        print_to_stdout("Collecting management stats...")
        collect_mgmt_stats()

    # === Core collection phase: cwd is the core sub-dir ===
    if args.DUMP_BLOCKED_TASKS_STATE:
        print_to_stdout("Dumping uninterruptible (blocked) tasks state...")
        prepare_env_for_log_collection()
    print_to_stdout("Creating log files...")
    create_log_files()
    print_to_stdout("Copying nvmesh system files...")
    copy_sys_files(args.COPY_SOURCES)
    print_to_stdout("Collecting nvme and network interfaces interrupts and information...")
    collect_nvme_and_network_interrupts_and_logs()
    print_to_stdout("Collecting journalctl...")
    collect_journalctl()
    print_to_stdout("Collecting Toma status...")
    collect_toma_status()
    print_to_stdout("Collecting Volumes information...")
    collect_volumes_info()
    print_to_stdout("Running Health Check script...")
    run_health_check()
    print_to_stdout("Collecting Toma dependency libraries...")
    collect_toma_dependency_libraries()
    print_to_stdout("Recording all module params...")
    record_module_params_values()
    print_to_stdout("Collecting installed packages info...")
    if DistributionMGR.collectNVMeshPackagesInfo() != True:
        print_to_stdout("WARNING: something went wrong while trying to collect NVMesh packages info")
    if DistributionMGR.collectAllPackagesInfo() != True:
        print_to_stdout("WARNING: something went wrong while trying to collect installed packages info")

    print_to_stdout("Collecting NVMeshUM logs...")
    collect_nvmeshum_logs()

    collect_nvmesh_apport_core_dumps()

    if args.COLLECT_KAFKA_LOGS:
        print_to_stdout("Trying to collect Kafka logs...")
        collect_kafka_topic_messages()

    if args.COLLECT_CRASH:
        print_to_stdout("Collecting last crash...")
        copy_last_crash_files()
        print_to_stdout("Collecting systemd Toma core dumps...")
        collect_systemd_toma_core_dumps()

    if args.COLLECT_SYSLOG:
        print_to_stdout("Collecting syslog...")
        copy_syslog_files()

    if args.COLLECT_TOMA_GCORE:
        print_to_stdout("Collecting Toma core using gcore...")
        collect_toma_core_using_gcore()

    if args.RUN_CLNT_ANALYZER:
        print_to_stdout("Running client analyzer...")
        run_client_analyzer()

    if args.RUN_SCAN_LOCKS:
        print_to_stdout("Running scan locks tool...")
        run_scan_locks()

    if args.COLLECT_TRACE_NFS_LOGS:
        check_and_collect_remote_trace_daemon_logs()

    # === Management collection phase: cwd is the mgmt sub-dir ===
    if is_mgmt:
        # Move cwd from the core sub-dir to the mgmt sub-dir (both are
        # siblings under the same run dir).
        os.chdir(os.path.join("..", mgmt_dir))

        # Mirror the small shared metadata files (customer + packages info)
        # from the core sub-dir so both archives are self-contained.
        for shared_file in (CUSTOMER_INFO_FILE_NAME, NVMESH_PKGS_INFO_FILE_NAME, ALL_PKGS_INFO_FILE_NAME):
            runCommand("ls ../{0}/{1} && cp -p ../{0}/{1} . || exit 0".format(core_dir, shared_file))

        print_to_stdout("Copying management-related files...")
        copy_mgmt_files()

        if args.COLLECT_SYSLOG:
            copy_syslog_files(mgmt_filter=True)

        print_to_stdout("Collecting management-filtered journalctl...")
        collect_journalctl(grep_pattern=MGMT_JOURNALCTL_FILTER)

        if args.DUMP_DB:
            dump_db_to_file()

    compress_and_tar_host_log_dirs(core_dir, mgmt_dir)


