def collect_journalctl(grep_pattern=None):
    # When grep_pattern is provided, the same journalctl commands are executed but
    # piped through `grep -i` before being written. This is used for the
    # management archive, where we want a filtered view. The output filenames
    # remain identical so each archive contains the same filenames with content
    # matching its scope.
    grep_suffix = " | grep -i '{0}'".format(grep_pattern) if grep_pattern else ""

    if args.JOURNALCTL_NUM_OF_LINES:
        file_name = "journalctl_curr_boot_log_%s_lines" % (args.JOURNALCTL_NUM_OF_LINES)
        runCommand("journalctl -xb -0 -n %s -o short-precise%s >> %s" % (args.JOURNALCTL_NUM_OF_LINES, grep_suffix, file_name))
        runCommand("journalctl -xb -1 -n %s -o short-precise%s >> %s" % (args.JOURNALCTL_NUM_OF_LINES, grep_suffix, file_name.replace("curr", "prev")))

    file_name = "journalctl_curr_boot_log_%s_seconds" % (args.JOURNALCTL_SINCE_DATE)
    runCommand("journalctl -xb -0 -S %s -o short-precise%s >> %s" % (args.JOURNALCTL_SINCE_DATE, grep_suffix, file_name))
    file_name = file_name.replace("curr", "prev")
    runCommand("journalctl -xb -1 -S %s -o short-precise%s >> %s" % (args.JOURNALCTL_SINCE_DATE, grep_suffix, file_name))

    if not args.JOURNALCTL_NUM_OF_LINES:
        runCommand("[ -s %s ] || journalctl -xb -1 -n 10000 -o short-precise%s >> journalctl_prev_boot_log_10000_lines" % (file_name, grep_suffix))


