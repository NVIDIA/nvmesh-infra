def dump_db_to_file(execToolCmd=None, dumpOutputDir=None):
    # check if db connectionstring resolve util exists
    if dumpOutputDir is None:
        dumpOutputDir = DB_DUMP_DIRNAME
        if os.path.isfile(MGMT_DB_UTIL_PATH) == False:
            return False
    else:
        cmd = "{0} [ -e {1} ]".format(execToolCmd, MGMT_DB_UTIL_PATH)
        res = runCommand(cmd)
        if res[2]:
            return False

    print_to_stdout("Dumping database...")

    # try get the db connection string using the resolve util
    cmds = []
    cmds.append("{0} getMongoManagementCommandLineArgumentsForMongoDump | tail -n 1".format(MGMT_DB_UTIL_PATH))
    cmds.append("{0} getMongoNVMeshMetadataCommandLineArgumentsForMongoDump | tail -n 1".format(MGMT_DB_UTIL_PATH))

    for cmd in cmds:
        if execToolCmd is not None:
            cmd = "{0} {1}".format(execToolCmd, cmd)
        res = runCommand(cmd)
        if res[2] or len(res[1]) == 0:
            print_to_stdout("Error: could not get DB connection string for dumping the DB: {0}".format(res[1]))
            return False

        # dump the db
        mongoCliArguments = res[1].rstrip().decode("utf-8")
        mongoCliArguments = mongoCliArguments.replace("$external",
                                                      "\\$external")  # "$external" is the name of the authentication DB when using TLS with X509 - should not be evaluated when running the command
        cmd = "mongodump {0} --out={1}".format(mongoCliArguments, dumpOutputDir)

        if not args.INCLUDE_ALL_DB_COLLECTIONS:
            exclude_flag = " --excludeCollection "
            # getMongoManagementCommandLineArgumentsForMongoDump case
            if cmd is cmds[0]:
                exclude_list = exclude_flag.join(DB_DUMP_EXCLUDED_COLLECTIONS)
            # getMongoNVMeshMetadataCommandLineArgumentsForMongoDump case
            else:
                exclude_list = exclude_flag.join(MD_DB_DUMP_EXCLUDED_COLLECTIONS)

            # add exclude_list and exclude_flag only if there are any collections to be excluded
            if exclude_list:
                cmd = "{0}{1}{2}".format(cmd, exclude_flag, exclude_list)

        if execToolCmd is not None:
            cmd = "{0} {1}".format(execToolCmd, cmd)

        res = runCommand(cmd)
        if res[2]:
            print_to_stdout("Failed to dump database to file {0}".format(res[1]))
            return False

    return True


