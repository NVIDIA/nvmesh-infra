def compress_and_tar_output_dir(outputDir=None):
    if outputDir is None:
        outputDir = get_output_dir_name()

    os.chdir("..")
    tgzFile = outputDir + ".tgz"
    print_to_stdout("Zipping and compressing...")
    runCommand("tar -cvzhSf " + tgzFile + " " + outputDir)
    print_to_stdout("Output file: " + tgzFile)
    print_to_stdout("Cleaning up source directory...")
    runCommand("rm -rf " + outputDir)
    print_to_stdout("--- Done ---")


def compress_and_tar_host_log_dirs(core_dir, mgmt_dir):
    """Produce the final tgz files inside the run directory and delete the sub-dirs.

    On entry, cwd is expected to be one of the collection sub-dirs (the mgmt
    one if it exists, otherwise the core one). On exit, cwd is the parent
    of the run directory (i.e. the original cwd where the script was invoked).

    The core tgz excludes management.out and the mgmtStats directory from
    the symlinked /var/log/nvmesh, since those belong to the management tgz.
    """
    # Step up to the run dir (parent of both sub-dirs).
    os.chdir("..")

    core_tgz = core_dir + ".tgz"
    excludes = (
        "--exclude='{0}/var/log/nvmesh/management.out' "
        "--exclude='{0}/var/log/nvmesh/mgmtStats'"
    ).format(core_dir)
    print_to_stdout("Zipping and compressing core logs...")
    runCommand("tar -cvzhSf {0} {1} {2}".format(core_tgz, excludes, core_dir))
    print_to_stdout("Output file: " + os.path.abspath(core_tgz))
    print_to_stdout("Cleaning up source directory...")
    runCommand("rm -rf " + core_dir)

    if mgmt_dir is not None:
        mgmt_tgz = mgmt_dir + ".tgz"
        print_to_stdout("Zipping and compressing management logs...")
        runCommand("tar -cvzhSf {0} {1}".format(mgmt_tgz, mgmt_dir))
        print_to_stdout("Output file: " + os.path.abspath(mgmt_tgz))
        print_to_stdout("Cleaning up management source directory...")
        runCommand("rm -rf " + mgmt_dir)

    # Return to the parent of the run dir (where the lock file lives).
    os.chdir("..")
    print_to_stdout("--- Done ---")


