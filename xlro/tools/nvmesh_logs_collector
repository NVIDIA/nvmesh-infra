class OsDistName(object):
    CENTOS = 'centos'
    REDHAT = 'redhat'
    UBUNTU = 'ubuntu'
    SUSE = 'suse'
    ORACLE_LINUX = 'oracle'
    ALMA_LINUX = 'almalinux'
    ROCKY_LINUX = 'rocky linux'


class DistManager(object):
    __metaclass__ = ABCMeta

    PKG_PREFIX = 'nvmesh-'
    NVMESH_CORE_PKG = ''.join([PKG_PREFIX, 'core'])
    NVMESH_MANAGEMENT_PKG = ''.join([PKG_PREFIX, 'management'])
    SYSLOG_FILE = '/var/log/messages'
    SYSLOG_ARCHIVE_DELIMITER = '-'

    @abstractmethod
    def getOsName(self):
        raise NotImplementedError

    @abstractmethod
    def isPackageInstalled(self, pkgName):
        raise NotImplementedError

    @abstractmethod
    def collectNVMeshPackagesInfo(self):
        raise NotImplementedError

    @abstractmethod
    def collectAllPackagesInfo(self):
        raise NotImplementedError


class RedhatDistManager(DistManager):
    def getOsName(self):
        return OsDistName.REDHAT

    def isPackageInstalled(self, pkgName):
        command = 'rpm -q {0}'.format(pkgName)
        result = runCommand(command)
        return result[2] == 0

    def collectNVMeshPackagesInfo(self):
        command = 'rpm -qa {0}* > {1}'.format(self.PKG_PREFIX, NVMESH_PKGS_INFO_FILE_NAME)
        result = runCommand(command)
        return result[2] == 0

    def collectAllPackagesInfo(self):
        command = 'rpm -qa > {0}'.format(ALL_PKGS_INFO_FILE_NAME)
        result = runCommand(command)
        return result[2] == 0


class UbuntuDistManager(DistManager):
    SYSLOG_FILE = '/var/log/syslog'
    SYSLOG_ARCHIVE_DELIMITER = '.'

    def getOsName(self):
        return OsDistName.UBUNTU

    def isPackageInstalled(self, pkgName):
        command = 'dpkg --list {0}'.format(pkgName)
        result = runCommand(command)
        return result[2] == 0

    def collectNVMeshPackagesInfo(self):
        command = 'dpkg --list {0}* > {1}'.format(self.PKG_PREFIX, NVMESH_PKGS_INFO_FILE_NAME)
        result = runCommand(command)
        return result[2] == 0

    def collectAllPackagesInfo(self):
        command = 'dpkg --list > {0}'.format(ALL_PKGS_INFO_FILE_NAME)
        result = runCommand(command)
        return result[2] == 0


def check_root():
    if not os.geteuid() == 0:
        sys.exit("Script must be run as root")


def get_freedesktop_os_release():
    os_release = {}
    os_release_info_file = "/etc/os-release"
    try:
        with open(os_release_info_file, "r") as f:
            for line in f:
                if "=" in line:
                    key, value = line.strip().split("=", 1)
                    os_release[key] = value.strip('"')
    except Exception as e:
        logging.error(f'Failed to read {os_release_info_file}, ex: {e}')

    return os_release


def initDistributionManager():
    platformInfo = platform.freedesktop_os_release() if hasattr(platform, "freedesktop_os_release") else  get_freedesktop_os_release()
    osName = platformInfo['NAME'].lower() if 'NAME' in platformInfo else None

    global DistributionMGR
    # as long as we don't need zypper for suse we can use the RedhatDistManager
    if osName in [OsDistName.CENTOS, OsDistName.REDHAT, OsDistName.SUSE, OsDistName.ORACLE_LINUX, OsDistName.ALMA_LINUX, OsDistName.ROCKY_LINUX]:
        DistributionMGR = RedhatDistManager()

    elif osName == OsDistName.UBUNTU:
        DistributionMGR = UbuntuDistManager()

    else:
        err = 'Detected Unsupported OS'
        if platformInfo:
            err += f' platformInfo: {platformInfo}'

        raise OSError(err)


