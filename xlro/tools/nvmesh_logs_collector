class CustomArgsParser(argparse.ArgumentParser):

    # override error function to allow for help to be printed on error
    def error(self, message):
        sys.stderr.write('Error: %s\n' % message)
        self.print_help()
        sys.exit(2)


def main():
    parser = CustomArgsParser(prog="python nvmesh_logs_collector", description='NVMesh log collector script')
    parser.add_argument('-c', action='store_true', dest='COLLECT_CRASH',
                        help="collect last crash file")
    parser.add_argument('-f', action='store_false', dest='FILTER_SYSLOG',
                        help="collect full syslog files (don't filter)")
    parser.add_argument('-i', action='store_false', dest='COLLECT_SYSLOG',
                        help="ignore syslog files")
    parser.add_argument('-a', action='store_true', dest='COLLECT_ARCHIVE_SYSLOG',
                        help="collect syslog archived files (gz or bz2)")
    parser.add_argument('-g', action='store_true', dest='COLLECT_TOMA_GCORE',
                        help="collect toma core file using gcore")
    parser.add_argument('-d', action='store_false', dest='DUMP_DB',
                        help="do not dump database to disk")
    parser.add_argument('-D', '--dump-blocked-tasks-state', action='store_true', dest='DUMP_BLOCKED_TASKS_STATE',
                        help="dump uninterruptible (blocked) tasks state")
    parser.add_argument('--all-collections', action='store_true', dest='INCLUDE_ALL_DB_COLLECTIONS',
                        help="include all collections while dumping the DB")
    parser.add_argument('-S', dest='JOURNALCTL_SINCE_DATE', type=int, default=-7200,
                        help="collect from journalctl entries not older than the specified time in seconds (default is 2h ago: -7200)")
    parser.add_argument('-n', metavar='N', type=int, dest='JOURNALCTL_NUM_OF_LINES',
                        help="choose number of lines to collect from journalctl")
    parser.add_argument('-z', action='store_true', dest='RUN_CLNT_ANALYZER',
                        help="run the nvmesh_clnt_analyzer tool to collect extra client logs")
    parser.add_argument('-l', action='store_true', dest='RUN_SCAN_LOCKS',
                        help="run the scan locks tool")
    parser.add_argument('--keywords', nargs='*', type=str, dest='keywords',
                        help="additional keywords to collect from syslog in addition to the default keywords")
    parser.add_argument('--containers', nargs='*', type=str, dest='DOCKER_CONTAINERS',
                        help="a list of docker containers to collect logs from")
    parser.add_argument('--kub-namespace', type=str, dest='KUB_NAMESPACE',
                        help="kubernetes namespace to collect logs from")
    parser.add_argument('--kub-pod', type=str, dest='KUB_POD',
                        help="kubernetes pod name to collect logs from")
    parser.add_argument('--kub-operator', action='store_true', dest='KUB_OPERATOR',
                        help="this flag is used when the script is run by the nvmesh kubernetes operator")
    parser.add_argument('-s', action='store_true', dest='COPY_SOURCES',
                        help="copy NVMesh source files (client and target)")
    parser.add_argument('--collect-trace-nfs-logs', action='store_true', dest='COLLECT_TRACE_NFS_LOGS',
                        help="checks if the trace daemon redirects its logs to an NFS server and collects that logs if so")
    parser.add_argument('--customer-name', type=str, dest='CUSTOMER_NAME', default="None",
                        help="adds the customer name into the " + CUSTOMER_INFO_FILE_NAME + " file")
    parser.add_argument('--customer-eng-contact', type=str, dest='CUSTOMER_ENG_CONTACT', default="None",
                        help="adds the customer engineer contact into the " + CUSTOMER_INFO_FILE_NAME + " file")
    parser.add_argument('--customer-eng-phone', type=str, dest='CUSTOMER_ENG_PHONE', default="None",
                        help="adds the customer engineer phone name into the " + CUSTOMER_INFO_FILE_NAME + " file")
    parser.add_argument('--customer-eng-email', type=str, dest='CUSTOMER_ENG_EMAIL', default="None",
                        help="adds the customer engineer email into the " + CUSTOMER_INFO_FILE_NAME + " file")
    parser.add_argument('-k', action='store_true', dest='COLLECT_KAFKA_LOGS',
                        help="collect kafka logs (messages by topics)")
    parser.add_argument('--kafka-config-path', type=str, dest='KAFKA_CONFIG_PATH',
                        help="kafka server config file path")
    global args
    args = parser.parse_args()
    collect_logs()


if __name__ == "__main__":
    lock_file = 'nvmesh_logs_collector.lock'
    fp = open(lock_file, 'w')

    try:
        fcntl.lockf(fp, fcntl.LOCK_EX | fcntl.LOCK_NB)
        logs_collector_pid = os.getpid()
        fp.write(str(logs_collector_pid))
        fp.flush()
    except IOError:
        # another instance is running
        print_to_stdout('Another instance is running, you can only run one instance at a time')
        sys.exit(0)

    main()
    os.remove(lock_file)

    sys.exit(0)
