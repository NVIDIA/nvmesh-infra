def collect_toma_dependency_libraries():
    target_repo_dir = os.path.join(MDIR, 'target-repo')
    if not os.path.exists(target_repo_dir):
        print_to_stdout(
            "ERROR: Failed to collect Toma dependency libraries, couldn't find {0}, nvmesh probably not installed".format(
                target_repo_dir))
        return

    for f in os.listdir(target_repo_dir):
        if f.startswith("target_"):
            executable_dir = os.path.join(target_repo_dir, f, "toma/bin/release")

            if os.path.exists(executable_dir):
                toma_exec = os.path.join(executable_dir, TOMA_EXECUTABLE_FILE_NAME)
                tar_name = "{0}.tar".format(f.replace('target', 'toma_libs'))
                cmd = "tar -czhvf {0} `ldd {1} | grep -E ' => ' | grep -v 'not found' | cut -d' ' -f3`".format(tar_name,
                                                                                                               toma_exec)
                res = runCommand(cmd)

                if res[2]:
                    print_to_stdout("ERROR: Failed to collect Toma dependency libraries for: {0}".format(toma_exec))
            else:
                print_to_stdout(
                    "ERROR: Failed to collect Toma dependency libraries, {} path not found".format(executable_dir))


