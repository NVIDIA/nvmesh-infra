def copy_sys_files(copySourceFiles=False):
    global SOURCE_FILES_TO_COPY_ARR
    if copySourceFiles:
        if args.KUB_OPERATOR:
            SOURCE_FILES_TO_COPY_ARR = ["/opt/nvmesh-operator/cache"]

        print_to_stdout("Collecting NVMesh source files...")
        for loc in SOURCE_FILES_TO_COPY_ARR:
            runCommand("ls {0} && cp -rp --parents {0} . || exit 0".format(loc))

    for loc in FILES_TO_COPY_ARR:
        runCommand("ls {0} && cp -rp --parents {0} . || exit 0".format(loc))

    # create symlinks for a later copy via tar following the links
    # reduces storage use on the machine
    for loc in FILES_TO_COPY_VIA_LINKS_ARR:
        dir_name = os.path.dirname(loc)
        dest_file = loc
        if loc[0] == '/':
            dest_file = loc[1:]
        if dir_name != '':
            os.makedirs(dir_name[1:])
        os.symlink(loc, dest_file)

    for loc in FILES_TO_TIMED_COPY_ARR:
        runTimedCommand("ls {0} && cp -rp --parents {0} . || exit 0".format(loc), timeout=10)

    # Copy configfs files. Because this is configfs, we must cat each file seperately.
    for loc in CONFIGFS_TO_COPY_ARR:
        # First make the subdirs
        runCommand("find {0} -type d -exec mkdir -p .{{}} \\;".format(loc))
        # Now "copy" the files
        runCommand("for i in `find {0} -type f`; do cat $i > .$i; done".format(loc))

    # collect var dir while excluding the backups, metadata_disk_image and mgr
    # directories (mgr belongs to the management tgz only).
    local_dest_var_dir = NVMESH_VAR_OPT_DIR[1:]
    runCommand("mkdir -p {0}; rsync -av --progress {1}/ {2} --exclude backups --exclude metadata_disk_image --exclude mgr".format(
        local_dest_var_dir, NVMESH_VAR_OPT_DIR, local_dest_var_dir))


def copy_last_crash_files():
    if os.path.exists(CRASH_DIR):
        crash_directories = [os.path.join(CRASH_DIR, name) for name in os.listdir(CRASH_DIR) if
                             os.path.isdir(os.path.join(CRASH_DIR, name))]
        if crash_directories != []:
            newest_crash = max(crash_directories, key=os.path.getctime)
            runCommand("cp -rp %s ." % newest_crash)
            crashdirname = os.path.basename(newest_crash)
            runCommand("cp -p {0}*{1}.crash {1}".format(CRASH_DIR, crashdirname))
        else:
            print_to_stdout("Crash dir is empty")
    else:
        print_to_stdout("No crash dir")


