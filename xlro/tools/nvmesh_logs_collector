def create_host_collection_dirs():
    """Create the run dir with core (always) and mgmt (if installed) sub-dirs.

    Layout produced:
        <cwd>/<host>_nvmesh_logs_<ts>/
            <host>_nvmesh_core_logs_<ts>/    <- core collection sub-dir
            <host>_nvmesh_mgmt_logs_<ts>/    <- mgmt collection sub-dir (only if mgmt installed)

    On return, cwd is the core collection sub-dir and logging is configured
    to write into it using an absolute path (so subsequent chdir does not move
    the log file).
    """
    run_dir = get_run_output_dir_name()
    core_name = get_host_collection_dir_name()
    mgmt_name = get_mgmt_collection_dir_name() if is_mgmt_installed() else None

    if not os.path.exists(run_dir):
        os.makedirs(run_dir)

    core_path = os.path.join(run_dir, core_name)
    if not os.path.exists(core_path):
        os.makedirs(core_path)

    if mgmt_name is not None:
        mgmt_path = os.path.join(run_dir, mgmt_name)
        if not os.path.exists(mgmt_path):
            os.makedirs(mgmt_path)

    os.chdir(core_path)
    logging.basicConfig(
        filename=os.path.abspath(LOG_FILE),
        level=logging.DEBUG,
        format='%(asctime)s\t%(levelname)s\t%(message)s',
    )

    return core_name, mgmt_name


def runTimedCommand(command, timeout):
    logging.debug('Subprocess: "' + command + '"')
    output = ''
    retcode = 1
    process = None

    def _communicate():
        output, _ = process.communicate()

    try:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=True)
        communicate_thread = threading.Thread(target=_communicate)
        # Mark thread as daemon because we understand the some commands may stuck in the kernel and
        # We need logs collector to finish
        communicate_thread.daemon = True
        try:
            communicate_thread.start()
            communicate_thread.join(timeout)
            if communicate_thread.is_alive():
                err = 'Error: Command {} timed out'.format(command)
                logging.error(err)
                print_to_stdout(err)
                # Kill the timed out process
                process.terminate()
        finally:
            retcode = process.returncode

            if retcode is None:
                # Processes still alive? let it 1 second to be close after the kill
                time.sleep(1)
                # We waited enough..
                retcode = process.returncode
                if retcode is None:
                    retcode = -110
            ret = (retcode == 0)

        if not ret:
            err = 'Error: Command {} timed out or failed with retcode {}'.format(command, retcode)
            logging.error(err)
            print_to_stdout(err)
        else:
            logging.debug('Subprocess finished')

    except (OSError) as exception:
        logging.error('Exception occured: ' + str(exception))
        logging.error('Subprocess failed')
        return (False, output, False)

    return (ret, output, retcode)


def log_fdisk_output():
    # Define log file paths
    nvme_log_file = "fdisk_dev_nvme_log"
    nvmesh_log_file = "fdisk_dev_nvmesh_log"
    # Get the list of block devices
    success, output, _ = runCommand("lsblk -nd -o NAME,TYPE")
    if not success:
        logging.error("Error running lsblk to collect disks for fdisk logs")
        return

    devices = [line.split()[0] for line in output.decode('utf-8').strip().split("\n") if "disk" in line]

    for dev in devices:
        dev_path = f"/dev/{dev}"
        log_file = None
        if dev_path.startswith("/dev/nvmesh"):
            log_file = nvmesh_log_file
        elif dev_path.startswith("/dev/nvme"):
            log_file = nvme_log_file

        if log_file:
            runTimedCommand(f"fdisk -l {dev_path} >> {log_file}; echo '' >> {log_file}", 10)


def runCommand(command):
    logging.debug('Subprocess: "' + command + '"')
    output = ''
    retcode = 1
    try:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=True)
        output, _ = process.communicate()
        retcode = process.returncode

        logging.debug(output)
    except OSError as exception:
        logging.error('Exception occured: ' + str(exception))
        logging.error('Subprocess failed')
        return False, output, False
    else:
        # no exception was raised
        logging.debug('Subprocess finished')

    return True, output, retcode


def collect_volumes_info():
    instances_list_file = '/proc/nvmeibc/inst_list.json'

    if not os.path.exists(instances_list_file):
        return

    res = runCommand('cat {0}'.format(instances_list_file))
    if res[2]:
        return

    try:
        inst_list_json = json.loads(res[1])

        for inst in inst_list_json['instances']:
            runCommand('cp -rp --parents /proc/{0}/volumes .'.format(inst['name']))
    except:
        return


def collect_filtered_interrupts_by_entity(entity):
    proc_interrupts_dir = 'proc'
    if not os.path.exists(proc_interrupts_dir):
        os.makedirs(proc_interrupts_dir)

    grep_io = ''
    if entity == 'nvme':
        grep_io = 'grep io |'

    cmd = 'for x in `grep {0} /proc/interrupts | {1} cut -d: -f1` ; do sudo cat /proc/irq/$x/smp_affinity_list ; done | sort | uniq -c > {2}/interrupts_{0}'.format(
        entity, grep_io, proc_interrupts_dir)
    runCommand(cmd)


def collect_nvme_and_network_interrupts_and_logs():
    for entity in ['nvme', 'ib', 'mlx']:
        collect_filtered_interrupts_by_entity(entity)

    net_proc = subprocess.Popen("ifconfig -a | sed 's/[ \t].*//;/^$/d'", stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, shell=True)
    net_proc.wait()
    net_lines = net_proc.stdout.readlines()
    ethtool_flags = ['--show-permaddr', '', '--show-pause', '--show-features', '--statistics']

    for line in net_lines:
        interface_name = line.decode("utf-8").rstrip(':\n')
        runCommand("echo '=================================================="
                   + " {0} ==================================================' >> {1}".format(interface_name,
                                                                                              ETHTOOL_LOG_FILE))
        for flag in ethtool_flags:
            cmd = ''
            if flag == '--statistics':
                cmd += "echo 'statistics for {0}:' >> {1};".format(interface_name, ETHTOOL_LOG_FILE)
            cmd += "ethtool {0} {1} >> {2}; echo  >> {2}".format(flag, interface_name, ETHTOOL_LOG_FILE)
            runCommand(cmd)

        collect_filtered_interrupts_by_entity(interface_name)


