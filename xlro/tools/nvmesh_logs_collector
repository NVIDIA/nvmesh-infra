                print_to_stdout("Error: could not copy the db dump dir from container: {0}".format(container_id))

    compress_and_tar_output_dir()


def collect_kubernetes_logs():
    print_to_stdout("collecting logs from kubernetes...")
    cmd = "which kubectl"
    res = runCommand(cmd)

    if int(res[2]) == True:
        print_to_stdout("Error: kubectl executable is missing, cannot collect logs from docker pods")
        return

    list_container_ids_cmd = "kubectl get -n {0} pods {1} -o jsonpath='{{.spec.containers[*].name}}'".format(
        args.KUB_NAMESPACE, args.KUB_POD)
    res = runCommand(list_container_ids_cmd)
    if int(res[2]) == True or res[1] == "":
        print_to_stdout("Error: could not list namespace/pod containers to collect logs from")
        return

    container_ids = res[1].split()

    outputDir = "{0}_nvmesh_logs_{1}_{2}_{3}".format(getBaseHostname(), args.KUB_NAMESPACE,
                                                     args.KUB_POD, time.strftime("%Y%m%d-%H%M%S"))
    create_initial_collection_dir_and_info(outputDir)

    for container_id in container_ids:
        get_logs_cmd = "kubectl logs --timestamps --since=2h -n {0} {1} -c {2} > {1}_{2}.logs".format(
            args.KUB_NAMESPACE, args.KUB_POD, container_id)
        res = runCommand(get_logs_cmd)
        if int(res[2]) == True:
            print_to_stdout("Error: could not fetch logs from kubernetes namespace: {0} pod: {1} container: {2}".format(
                args.KUB_NAMESPACE, args.KUB_POD, container_id))

        if not args.DUMP_DB:
            continue

        success = dump_db_to_file(
            "kubectl exec -n {0} {1} -c {2} --".format(args.KUB_NAMESPACE, args.KUB_POD, container_id),
            REMOTE_DB_DUMP_PATH)
        if success:
            # bring the dump
            cp_db_dump_cmd = "kubectl cp {0}/{1}:{2} ./{1}_{3}_{4} -c {3}".format(args.KUB_NAMESPACE, args.KUB_POD,
                                                                                  REMOTE_DB_DUMP_PATH, container_id,
                                                                                  DB_DUMP_DIRNAME)
            res = runCommand(cp_db_dump_cmd)
            if int(res[2]) == True:
                print_to_stdout(
                    "Error: could not copy the db dump dir from namespace: {0} pod: {1} container: {2}".format(
                        args.KUB_NAMESPACE, args.KUB_POD, container_id))

    compress_and_tar_output_dir(outputDir)


def collect_kafka_topic_messages():
    kafka_conf_file = KAFKA_CONF_PATH
    if args.KAFKA_CONFIG_PATH is not None and args.KAFKA_CONFIG_PATH != '':
        kafka_conf_file = args.KAFKA_CONFIG_PATH

    if not os.path.exists(kafka_conf_file):
        print_to_stdout(
            "Error: could not find kafka server config file in the following path: {0}".format(kafka_conf_file))
        return

    print_to_stdout("Collecting Kafka log files by topic...")

    # get all occurrences of log.dirs without the commented ones
    res = runCommand("cat {0} | grep log.dirs | grep -ve '#*.log.dirs'".format(kafka_conf_file))
    log_dir_not_found_err = "Error: could not find log dir location in {}".format(kafka_conf_file)
    if int(res[2]) == True or res[1] == "":
        print_to_stdout(log_dir_not_found_err)
        return

    try:
        # parse server.properties to find the log dir
        raw_log_dir = res[1].decode("utf-8").strip().split('\n')
        if len(raw_log_dir) == 0:
            print_to_stdout(log_dir_not_found_err)
            return

        # get last occurrence of log_dir and fetch the path itself
        log_dir = raw_log_dir[len(raw_log_dir) - 1].split("=")[1].strip()
        if not os.path.exists(log_dir):
            print_to_stdout("Error: configured kafka log dir doesn't exist {}".format(log_dir))
            return

        res = runCommand("tar -czSf kafka_topic_logs.tar {0}/*/*.log kafka_topic_logs/".format(log_dir))
        if int(res[2]) == True:
            print_to_stdout("Error: could not collect log files for kafka topics, err {}".format(res[1]))
            return
    except Exception as error:
        print_to_stdout("Error: could not collect kafka log files, err: {0}".format(error))

