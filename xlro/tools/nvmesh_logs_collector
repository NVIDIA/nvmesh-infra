        return toma_pid.strip()
    else:
        return False

def collect_toma_status():
    if TOMA_PID:
        max_retries = 5

        status_files_list = glob.glob(NVMESH_LOG_DIR + "*.stat")
        if len(status_files_list) > 0:
            prev_status = max(status_files_list, key=os.path.getctime)
        else:
            prev_status = ""

        # signaling 10 to toma for creating the status file
        res = runCommand("kill -10 %s" % TOMA_PID);

        if res[2]:
            print_to_stdout("WARNING: Toma status file creation failed")
            return

        success = False
        retry = 0
        while retry < max_retries and not success:
            # collecting the status file if exists
            status_files_list = glob.glob(NVMESH_LOG_DIR + "*.stat")
            if len(status_files_list) > 0:
                newest_status = max(status_files_list, key=os.path.getctime)
                if prev_status != newest_status:
                    runCommand("cp -rp %s ." % newest_status)
                    success = True

            retry += 1
            if not success:
                print_to_stdout("Waiting for Toma status file to be created")
                time.sleep(1)

        if not success:
            print_to_stdout("WARNING: Toma new status file doesn't exists")
    else:
        print_to_stdout("Warning: Can not find TOMA pid file (Toma might be down)")


